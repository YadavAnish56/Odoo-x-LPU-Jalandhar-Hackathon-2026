# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stocksense

# Authentication
JWT_SECRET=supersecretkey-dev-environment-change-in-prod
JWT_EXPIRES_IN=7d

# Frontend CORS
CORS_ORIGIN=http://localhost:3000

# OTP Configuration
OTP_EXPIRY_MINUTES=10

# Mail / SMTP (Optional in local development; OTP is printed to server console if blank)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=StockSense <no-reply@stocksense.local>
