# Copy this file to .env and fill in your values.

PORT=5000
NODE_ENV=development

# PostgreSQL connection: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# The database is created automatically by `npm run db:init` if it does not exist.
DATABASE_URL=postgres://postgres:your_password@localhost:5432/stocksense

# Long random string used to sign login tokens (required in production)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend URL(s) allowed to call the API, comma separated. * = allow all (development)
CORS_ORIGIN=*

# Number of proxies in front of the server (Render, Railway, Nginx). Default: 1 when NODE_ENV=production.
# TRUST_PROXY=1

# Password reset OTP
OTP_EXPIRY_MINUTES=10
# Demo accounts have no real inbox, so their OTP is shown on screen instead of emailed (comma separated).
# Default: manager@stocksense.com,staff@stocksense.com. An empty value turns this off.
# DEMO_EMAILS=manager@stocksense.com,staff@stocksense.com

# Email (SMTP) for sending OTPs. Leave SMTP_HOST empty during development:
# the OTP is then printed in the server console and returned as "devOtp".
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=StockSense <no-reply@stocksense.local>

# Only needed for `npm test` - a separate database that gets wiped (name must contain "test")
TEST_DATABASE_URL=postgres://postgres:your_password@localhost:5432/stocksense_test
